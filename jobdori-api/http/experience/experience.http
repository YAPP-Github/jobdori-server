@projectId = 1
@experienceId = 1

### Create STAR experience
POST {{host}}/v1/workspaces/{{workspaceId}}/experiences
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "projectId": {{projectId}},
    "tags": [
        "backend",
        "performance"
    ],
    "title": "지원서 조회 성능 개선",
    "contents": {
        "type": "STAR",
        "star": {
            "situation": "지원서 목록 조회가 느려 운영자가 반복 업무에서 지연을 겪고 있었습니다.",
            "task": "대량 데이터에서도 안정적인 응답 시간을 유지하도록 조회 로직을 개선해야 했습니다.",
            "action": "쿼리 조건과 인덱스를 재검토하고 커서 기반 페이지네이션으로 변경했습니다.",
            "result": "목록 조회 응답 시간이 줄고 피크 시간대 타임아웃이 해소되었습니다."
        }
    }
}

### Create FREE experience
POST {{host}}/v1/workspaces/{{workspaceId}}/experiences
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "projectId": {{projectId}},
    "tags": [
        "api",
        "docs"
    ],
    "title": "REST Docs 문서화 정비",
    "contents": {
        "type": "FREE",
        "free": {
            "content": "경험 도메인의 API 요청/응답 예시를 정리하고 REST Docs 테스트를 보강했습니다."
        }
    }
}

### Update experience
PATCH {{host}}/v1/workspaces/{{workspaceId}}/experiences/{{experienceId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "projectId": {{projectId}},
    "tags": [
        "backend",
        "performance",
        "query"
    ],
    "title": "지원서 조회 API 성능 개선",
    "contents": {
        "type": "STAR",
        "star": {
            "situation": "지원서 목록 조회 지연으로 운영 업무 처리 속도가 낮아지고 있었습니다.",
            "task": "데이터가 증가해도 일정한 응답 시간을 유지하는 조회 API가 필요했습니다.",
            "action": "복합 인덱스를 추가하고 커서 기반 조회 흐름으로 API를 개선했습니다.",
            "result": "조회 응답 시간이 안정화되고 운영자의 반복 조회 업무 지연이 줄었습니다."
        }
    }
}

### Delete experience
DELETE {{host}}/v1/workspaces/{{workspaceId}}/experiences/{{experienceId}}
Authorization: Bearer {{accessToken}}
