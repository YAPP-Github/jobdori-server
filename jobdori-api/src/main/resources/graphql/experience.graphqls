extend type Query {
    """
    경험 단건을 조회합니다.
    """
    experience(
        """
        경험을 조회할 워크스페이스 ID입니다.
        """
        workspaceId: ID!,
        """
        조회할 경험 ID입니다.
        """
        experienceId: ID!
    ): Experience

    """
    경험 목록을 조회합니다 (프로젝트 ID가 있는 경우 특정 프로젝트 내로 한정)
    """
    experiences(
        """
        경험 목록을 조회할 워크스페이스 ID입니다.
        """
        workspaceId: ID!,
        """
        특정 프로젝트의 경험만 조회할 때 사용하는 프로젝트 ID입니다 (선택)
        """
        projectId: ID = null,
        """
        JD ID입니다. 주면 지원 전략(strategy)과 각 경험에 해당 JD 기준 matchRate와 recommendedReason(상위 5개)을 채웁니다. (선택)
        """
        jdId: ID = null,
        """
        다음 페이지를 조회할 때 사용하는 커서입니다. (첫 페이지는 null)
        """
        cursor: String = null,
        """
        한 번에 조회할 경험 개수입니다. (1 이상 30 이하)
        """
        size: Int! = 10
    ): Experiences!

    """
    경험 프로젝트 단건을 조회합니다.
    """
    experienceProject(
        """
        경험 프로젝트가 속한 워크스페이스 ID입니다.
        """
        workspaceId: ID!,
        """
        조회할 경험 프로젝트 ID입니다.
        """
        projectId: ID!
    ): ExperienceProject!

    """
    경험 프로젝트 목록을 조회합니다.
    """
    experienceProjects(
        """
        경험 프로젝트 목록을 조회할 워크스페이스 ID입니다.
        """
        workspaceId: ID!,
        """
        다음 페이지를 조회할 때 사용하는 커서입니다. (첫 페이지는 null)
        """
        cursor: String = null,
        """
        한 번에 조회할 경험 프로젝트 개수입니다. (1 이상 30 이하)
        """
        size: Int! = 10
    ): ExperienceProjects!

    """
    키워드 기반으로 경험 목록을 검색합니다.
    """
    searchExperiences(
        """
        경험을 검색할 워크스페이스 ID입니다.
        """
        workspaceId: ID!,
        """
        검색어입니다.
        """
        keyword: String!,
        """
        다음 페이지를 조회할 때 사용하는 커서입니다. (첫 페이지는 null)
        """
        cursor: String = null,
        """
        한 번에 조회할 경험 개수입니다. (1 이상 30 이하)
        """
        size: Int! = 10
    ): Experiences!
}

extend type Mutation {
    """
    경험을 생성합니다.
    """
    createExperience(
        """
        경험을 생성할 워크스페이스 ID입니다.
        """
        workspaceId: ID!,
        """
        생성할 경험 정보입니다.
        """
        request: CreateExperienceRequest!
    ): Experience!

    """
    경험을 수정합니다.
    """
    updateExperience(
        """
        경험이 속한 워크스페이스 ID입니다.
        """
        workspaceId: ID!,
        """
        수정할 경험 ID입니다.
        """
        experienceId: ID!,
        """
        수정할 경험 정보입니다.
        """
        request: UpdateExperienceRequest!
    ): Experience!

    """
    경험을 삭제합니다.
    """
    deleteExperience(
        """
        경험이 속한 워크스페이스 ID입니다.
        """
        workspaceId: ID!,
        """
        삭제할 경험 ID입니다.
        """
        experienceId: ID!
    ): Boolean!

    """
    경험 프로젝트를 생성합니다.
    """
    createExperienceProject(
        """
        경험 프로젝트를 생성할 워크스페이스 ID입니다.
        """
        workspaceId: ID!,
        """
        생성할 경험 프로젝트 정보입니다.
        """
        input: CreateExperienceProjectRequest!
    ): ExperienceProject!

    """
    경험 프로젝트를 수정합니다.
    """
    updateExperienceProject(
        """
        경험 프로젝트가 속한 워크스페이스 ID입니다.
        """
        workspaceId: ID!,
        """
        수정할 경험 프로젝트 ID입니다.
        """
        projectId: ID!,
        """
        수정할 경험 프로젝트 정보입니다.
        """
        request: UpdateExperienceProjectRequest!
    ): ExperienceProject!

    """
    경험 프로젝트를 삭제합니다.
    """
    deleteExperienceProject(
        """
        경험 프로젝트가 속한 워크스페이스 ID입니다.
        """
        workspaceId: ID!,
        """
        삭제할 경험 프로젝트 ID입니다.
        """
        projectId: ID!
    ): Boolean!
}

"""
경험 생성 입력입니다.
"""
input CreateExperienceRequest {
    """
    연결할 경험 프로젝트 ID입니다.
    """
    projectId: ID!

    """
    경험에 부여할 태그 목록입니다.
    """
    tags: [String!] = []

    """
    경험 제목입니다.
    """
    title: String!

    """
    경험 상세 내용입니다.
    """
    contents: ExperienceContentsRequest!

    """경험 수행 기간입니다."""
    period: PeriodInput

    """경험에서 맡은 역할입니다."""
    role: String
}

"""
경험 수정 입력입니다.
"""
input UpdateExperienceRequest {
    """
    변경할 경험 프로젝트 ID입니다.
    """
    projectId: ID!

    """
    변경할 태그 목록입니다.
    """
    tags: [String!]!

    """
    변경할 경험 제목입니다.
    """
    title: String!

    """
    변경할 경험 상세 내용입니다.
    """
    contents: ExperienceContentsRequest!

    """변경할 경험 수행 기간입니다."""
    period: PeriodInput

    """변경할 경험 역할입니다."""
    role: String
}

"""
경험 상세 내용 입력입니다.
"""
input ExperienceContentsRequest {
    """
    경험 상세 내용 타입입니다.
    """
    type: ExperienceContentsType!

    """
    STAR 형식의 상세 내용입니다.
    """
    star: StarExperienceContentsRequest = null

    """
    FREE 형식의 상세 내용입니다.
    """
    free: FreeExperienceContentsRequest = null
}

"""
STAR 형식의 경험 상세 내용 입력입니다.
"""
input StarExperienceContentsRequest {
    """
    S
    """
    situation: String!

    """
    T
    """
    task: String!

    """
    A
    """
    action: String!

    """
    R
    """
    result: String!
}

"""
FREE 형식의 경험 상세 내용 입력입니다.
"""
input FreeExperienceContentsRequest {
    """
    자유 내용입니다.
    """
    content: String!
}

"""
경험 프로젝트 생성 입력입니다.
"""
input CreateExperienceProjectRequest {
    """
    경험 프로젝트 이름입니다.
    """
    name: String!

    """
    경험 프로젝트 요약입니다.
    """
    summary: String!

    """
    경험 프로젝트 진행 기간입니다.
    """
    period: PeriodInput

    """
    경험 프로젝트 역할입니다.
    """
    role: String
}

"""
경험 프로젝트 수정 입력입니다.
"""
input UpdateExperienceProjectRequest {
    """
    변경할 경험 프로젝트 이름입니다.
    """
    name: String!

    """
    변경할 경험 프로젝트 요약입니다.
    """
    summary: String!

    """
    변경할 경험 프로젝트 진행 기간입니다.
    """
    period: PeriodInput

    """
    변경할 경험 프로젝트 역할입니다.
    """
    role: String
}

"""
경험 목록입니다.
"""
type Experiences {
    """
    조회된 경험 목록입니다.
    """
    experiences: [Experience!]!

    """
    JD 기준 지원 전략입니다. experiences 조회에 jdId를 준 경우에만 채워집니다.
    """
    strategy: String

    """
    다음 페이지 조회에 사용하는 커서 정보입니다.
    """
    cursor: Cursor!
}

"""
경험 프로젝트 목록입니다.
"""
type ExperienceProjects {
    """
    조회된 경험 프로젝트 목록입니다.
    """
    projects: [ExperienceProject!]!

    """
    다음 페이지 조회에 사용하는 커서 정보입니다.
    """
    cursor: Cursor!
}

"""
경험입니다.
"""
type Experience {
    """
    경험을 식별하는 ID입니다.
    """
    experienceId: ID!

    """
    경험이 연결된 프로젝트입니다.
    """
    project: ExperienceProject

    """
    경험에 부여된 태그 목록입니다.
    """
    tags: [String!]!

    """
    경험 제목입니다.
    """
    title: String!

    """
    경험 상세 내용입니다.
    """
    contents: ExperienceContents!

    """경험 수행 기간입니다."""
    period: Period

    """경험에서 맡은 역할입니다."""
    role: String

    """
    JD 기준 매칭률(0~100)입니다. experiences 조회에 jdId를 준 경우에만 채워집니다.
    """
    matchRate: Int

    """
    선정 이유입니다. 매칭률 상위 5개 경험에만 채워집니다. (그 외 null)
    """
    recommendedReason: String
}

"""
경험 상세 내용입니다.
"""
type ExperienceContents {
    """
    경험 상세 내용 타입입니다.
    """
    type: ExperienceContentsType!

    """
    STAR 형식의 상세 내용입니다.
    """
    star: StarExperienceContents

    """
    FREE 형식의 상세 내용입니다.
    """
    free: FreeExperienceContents
}

"""
STAR 형식의 경험 상세 내용입니다.
"""
type StarExperienceContents {
    """
    상황입니다.
    """
    situation: String!

    """
    과제입니다.
    """
    task: String!

    """
    행동입니다.
    """
    action: String!

    """
    결과입니다.
    """
    result: String!
}

"""
FREE 형식의 경험 상세 내용입니다.
"""
type FreeExperienceContents {
    """
    자유 내용입니다.
    """
    content: String!
}

"""
경험 프로젝트입니다.
"""
type ExperienceProject {
    """
    경험 프로젝트를 식별하는 ID입니다.
    """
    projectId: ID!

    """
    경험 프로젝트 이름입니다.
    """
    name: String!

    """
    경험 프로젝트 요약입니다.
    """
    summary: String!

    """
    경험 프로젝트 진행 기간입니다.
    """
    period: Period

    """
    경험 프로젝트에서 맡은 역할입니다.
    """
    role: String

    """
    경험 프로젝트에 연결된 활성 경험 개수입니다.
    """
    experienceCount: Long
}

"""
경험 상세 내용 타입입니다.
"""
enum ExperienceContentsType {
    """
    Situation, Task, Action, Result로 구성된 형식입니다.
    """
    STAR

    """
    자유 서술 형식입니다.
    """
    FREE
}
