extend type Query {
    """
    JD 담당업무와 우대사항을 바탕으로, 지원자에게 해당 경험이 있는지 묻는 질문 대화방 카드 목록을 조회합니다.
    JD별 최초 조회 시 AI가 생성해 저장하므로 응답이 느릴 수 있으며, 이후에는 저장된 목록을 그대로 반환합니다.
    목록은 0~5개입니다. 담당업무와 우대사항이 모두 비어 있거나 AI가 쓸 만한 질문을 만들지 못하면 빈 목록을 반환하고 저장하지 않습니다.
    AI 생성에 실패하면 오류를 반환하며 아무것도 저장하지 않으므로, 같은 요청을 다시 보내면 재시도됩니다.
    """
    experienceQuestionRooms(
        """
        조회할 워크스페이스의 ID입니다.
        """
        workspaceId: ID!,
        """
        조회할 JD의 ID입니다.
        """
        jdId: ID!
    ): [ExperienceQuestionRoomCard!]!
}

"""
JD 항목 하나를 근거로 지원자에게 경험 유무를 묻는 질문 대화방 카드입니다.
"""
type ExperienceQuestionRoomCard {
    """
    질문 대화방을 식별하는 공개 ID입니다. 최초 생성 후 바뀌지 않으며 대화방 상세 진입에 사용합니다.
    """
    questionRoomId: ID!

    """
    지원자에게 묻는 경험 질문입니다. 예: 기능 검증을 위해 테스트 케이스(TC)를 직접 설계한 경험이 있나요?
    """
    question: String!

    """
    질문을 만든 JD 항목 종류입니다.
    """
    sourceType: ExperienceQuestionRoomSourceType!

    """
    질문의 근거가 된 JD 항목 원문입니다.
    """
    sourceText: String!

    """
    이 대화방의 블록을 이력서에 한 번이라도 적용했는지 여부입니다. 적용한 이력서 아이템을 나중에 이력서에서 지워도 true로 남습니다.
    """
    applied: Boolean!
}

"""
경험 질문 카드의 출처 항목 종류입니다.
"""
enum ExperienceQuestionRoomSourceType {
    """
    JD 담당업무 항목입니다.
    """
    RESPONSIBILITY

    """
    JD 우대사항 항목입니다.
    """
    PREFERRED_EXPERIENCE
}

extend type Query {
    """
    경험 질문 대화방의 질문 카드와 전체 메시지를 오래된 순서로 조회합니다.
    """
    experienceQuestionRoom(
        """
        조회할 워크스페이스의 ID입니다.
        """
        workspaceId: ID!,
        """
        조회할 질문 대화방의 ID입니다. (experienceQuestionRooms의 questionRoomId)
        """
        questionRoomId: ID!
    ): ExperienceQuestionRoomDetail!
}

extend type Mutation {
    """
    질문 대화방에 사용자 입력을 보내고 AI가 만든 경험 블록과 피드백을 반환합니다.
    content와 experienceIds 중 하나는 있어야 하며, 경험은 같은 프로젝트에서 최대 5개까지 선택할 수 있습니다.
    AI가 응답을 만드는 동안 시간이 걸리며, 실패하면 아무것도 저장하지 않으므로 같은 입력으로 다시 보내면 됩니다.
    """
    sendExperienceQuestionRoomMessage(
        """
        질문 대화방이 속한 워크스페이스의 ID입니다.
        """
        workspaceId: ID!,
        """
        메시지를 보낼 질문 대화방의 ID입니다.
        """
        questionRoomId: ID!,
        """
        보낼 메시지입니다.
        """
        request: SendExperienceQuestionRoomMessageRequest!
    ): ExperienceQuestionRoomMessage!

    """
    AI 블록을 이력서 경험 섹션 맨 아래 아이템으로 적용합니다. 같은 대화방에서 같은 이력서에 다시 적용하면 그 아이템의 이름과 내용만 갱신합니다.
    이력서는 전체 저장 방식이므로 적용 후 이력서를 다시 조회해야 합니다. 예전 상태로 updateResume를 호출하면 적용된 아이템이 삭제됩니다.
    """
    applyExperienceQuestionRoomBlock(
        """
        질문 대화방과 이력서가 속한 워크스페이스의 ID입니다.
        """
        workspaceId: ID!,
        """
        적용할 블록이 있는 질문 대화방의 ID입니다.
        """
        questionRoomId: ID!,
        """
        적용할 AI 메시지의 ID입니다. (role이 AI인 메시지)
        """
        messageId: ID!,
        """
        블록을 적용할 이력서의 ID입니다.
        """
        resumeId: ID!
    ): ResumeSectionItem!
}

"""
질문 대화방 메시지 전송 입력입니다.
"""
input SendExperienceQuestionRoomMessageRequest {
    """
    사용자가 입력한 내용입니다. (최대 2000자, 경험을 선택했다면 생략 가능)
    """
    content: String = null

    """
    함께 보낼 경험 ID 목록입니다. (같은 프로젝트에서 최대 5개)
    """
    experienceIds: [ID!]! = []
}

"""
질문 대화방 상세입니다.
"""
type ExperienceQuestionRoomDetail {
    """
    질문 카드입니다.
    """
    room: ExperienceQuestionRoomCard!

    """
    대화 메시지 목록입니다. (오래된 순서)
    """
    messages: [ExperienceQuestionRoomMessage!]!
}

"""
질문 대화방 메시지입니다. role이 USER면 content/experienceIds, AI면 block/feedback이 채워집니다.
"""
type ExperienceQuestionRoomMessage {
    """
    메시지 ID입니다. AI 메시지의 ID로 블록을 이력서에 적용합니다.
    """
    messageId: ID!

    """
    메시지를 보낸 쪽입니다.
    """
    role: ExperienceQuestionRoomMessageRole!

    """
    사용자가 입력한 내용입니다. (USER, 입력하지 않았으면 null)
    """
    content: String

    """
    사용자가 선택한 경험 ID 목록입니다. (USER)
    """
    experienceIds: [ID!]

    """
    AI가 만든 경험 블록입니다. (AI)
    """
    block: ExperienceQuestionRoomBlock

    """
    AI 피드백입니다. (AI)
    """
    feedback: ExperienceQuestionRoomFeedback

    """
    메시지가 저장된 시각입니다.
    """
    createdAt: String!
}

"""
AI가 만든 이력서 경험 블록입니다.
"""
type ExperienceQuestionRoomBlock {
    """
    블록 제목입니다. 적용 시 이력서 경험 아이템의 이름이 됩니다.
    """
    title: String!

    """
    블록 본문 불릿입니다. (2~4개, 적용 시 "- " 불릿으로 이어 붙여 contents가 됩니다)
    """
    bullets: [String!]!
}

"""
AI 피드백입니다.
"""
type ExperienceQuestionRoomFeedback {
    """
    JD 질문에 대한 적합도 평가 한 문장입니다.
    """
    fit: String!

    """
    개선 방향 한 문장입니다.
    """
    improvement: String!
}

"""
메시지를 보낸 쪽입니다.
"""
enum ExperienceQuestionRoomMessageRole {
    """
    사용자입니다.
    """
    USER

    """
    AI입니다.
    """
    AI
}
