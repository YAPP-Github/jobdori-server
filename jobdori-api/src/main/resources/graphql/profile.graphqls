extend type Query {
    """
    이력서 기본 정보 프로필을 조회합니다. 프로필이 없으면 빈 프로필을 생성해 반환합니다. (워크스페이스당 1개)
    """
    profile(
        """
        프로필을 조회할 워크스페이스 ID입니다.
        """
        workspaceId: ID!
    ): Profile!

}

extend type Mutation {
    """
    이력서 기본 정보 프로필을 수정합니다. null 필드는 미변경, 섹션 리스트는 전체 교체됩니다 (빈 리스트 = 비우기, 배열 순서 = 노출 순서).
    """
    updateProfile(
        """
        프로필이 속한 워크스페이스 ID입니다.
        """
        workspaceId: ID!,
        """
        수정할 프로필 정보입니다.
        """
        request: UpdateProfileRequest!
    ): Profile!

    """
    프로필 정보(경력/프로젝트/스킬)를 바탕으로 핵심역량을 AI로 생성합니다. 결과만 반환하고 저장하지 않습니다.
    """
    generateCoreCompetency(
        """
        워크스페이스 ID입니다.
        """
        workspaceId: ID!
    ): String!

    """
    프로필 텍스트(핵심역량/경력 세부/경험명/STAR 설명)를 AI로 다듬습니다. 결과만 반환하고 저장하지 않습니다.
    """
    polishProfileText(
        """
        텍스트 다듬기 입력입니다.
        """
        request: PolishProfileTextRequest!
    ): String!
}

"""
이력서 기본 정보 프로필입니다. 이력서에 들어가는 정보의 원본을 워크스페이스당 1개 관리합니다.
"""
type Profile {
    """
    프로필을 식별하는 ID입니다.
    """
    profileId: ID!

    """
    이름입니다.
    """
    name: String

    """
    전화번호입니다.
    """
    phone: String

    """
    이메일입니다.
    """
    email: String

    """
    핵심역량입니다. (최대 500자)
    """
    coreCompetency: String

    """
    학력 목록입니다.
    """
    educations: [ProfileEducation!]!

    """
    경력 목록입니다.
    """
    careers: [ProfileCareer!]!

    """
    어학 목록입니다.
    """
    languageTests: [ProfileLanguageTest!]!

    """
    수상 목록입니다.
    """
    awards: [ProfileAward!]!

    """
    자격증 목록입니다.
    """
    certifications: [ProfileCertification!]!

    """
    스킬 목록입니다.
    """
    skills: [ProfileSkill!]!
}

"""
학위입니다.
"""
enum Degree {
    """
    학사
    """
    BACHELOR

    """
    석사
    """
    MASTER

    """
    박사
    """
    DOCTOR
}

"""
학적 상태입니다.
"""
enum EducationStatus {
    """
    재학
    """
    ENROLLED

    """
    휴학
    """
    ON_LEAVE

    """
    졸업
    """
    GRADUATED

    """
    졸업예정
    """
    EXPECTED_GRADUATION

    """
    수료
    """
    COMPLETED
}

"""
스킬 숙련도입니다.
"""
enum SkillLevel {
    """
    상
    """
    HIGH

    """
    중
    """
    MEDIUM

    """
    하
    """
    LOW
}

"""
프로필 텍스트 다듬기 대상 항목입니다.
"""
enum ProfilePolishKind {
    """
    핵심역량 (최대 500자)
    """
    CORE_COMPETENCY

    """
    경력 세부 내용 (최대 500자)
    """
    CAREER_DESCRIPTION

    """
    경험명 (최대 48자)
    """
    EXPERIENCE_TITLE

    """
    경험 STAR 설명 (최대 600자)
    """
    EXPERIENCE_DESCRIPTION
}

"""
학력입니다.
"""
type ProfileEducation {
    """
    학교 또는 기관명입니다.
    """
    school: String

    """
    전공명입니다.
    """
    major: String

    """
    학위입니다. (학사/석사/박사)
    """
    degree: Degree

    """
    학적 상태입니다. (재학/휴학/졸업/졸업예정/수료)
    """
    status: EducationStatus

    """
    기간입니다.
    """
    period: Period
}

"""
경력입니다.
"""
type ProfileCareer {
    """
    회사명입니다.
    """
    company: String

    """
    직책입니다.
    """
    position: String

    """
    기간입니다.
    """
    period: Period

    """
    세부 내용입니다. (최대 500자)
    """
    description: String
}

"""
어학입니다.
"""
type ProfileLanguageTest {
    """
    시험명입니다.
    """
    testName: String

    """
    점수 또는 등급입니다.
    """
    score: String

    """
    취득일입니다. (YYYY-MM-DD)
    """
    acquiredAt: String
}

"""
수상입니다.
"""
type ProfileAward {
    """
    수상명입니다.
    """
    title: String

    """
    수여 기관명입니다.
    """
    organization: String

    """
    수상일입니다. (YYYY-MM-DD)
    """
    awardedAt: String
}

"""
자격증입니다.
"""
type ProfileCertification {
    """
    자격명입니다.
    """
    name: String

    """
    발급 기관명입니다.
    """
    issuer: String

    """
    취득일입니다. (YYYY-MM-DD)
    """
    acquiredAt: String
}

"""
스킬입니다.
"""
type ProfileSkill {
    """
    기술 또는 도구명입니다.
    """
    name: String

    """
    숙련도입니다. (상/중/하)
    """
    level: SkillLevel
}

"""
프로필 수정 입력입니다. null 필드는 미변경, 섹션 리스트는 전체 교체됩니다.
"""
input UpdateProfileRequest {
    """
    변경할 이름입니다.
    """
    name: String = null

    """
    변경할 전화번호입니다. (형식: 010-1234-5678, 빈 문자열 = 비우기)
    """
    phone: String = null

    """
    변경할 이메일입니다.
    """
    email: String = null

    """
    변경할 핵심역량입니다. (최대 500자)
    """
    coreCompetency: String = null

    """
    변경할 학력 목록입니다. (전체 교체)
    """
    educations: [ProfileEducationRequest!] = null

    """
    변경할 경력 목록입니다. (전체 교체)
    """
    careers: [ProfileCareerRequest!] = null

    """
    변경할 어학 목록입니다. (전체 교체)
    """
    languageTests: [ProfileLanguageTestRequest!] = null

    """
    변경할 수상 목록입니다. (전체 교체)
    """
    awards: [ProfileAwardRequest!] = null

    """
    변경할 자격증 목록입니다. (전체 교체)
    """
    certifications: [ProfileCertificationRequest!] = null

    """
    변경할 스킬 목록입니다. (전체 교체)
    """
    skills: [ProfileSkillRequest!] = null
}

"""
학력 입력입니다.
"""
input ProfileEducationRequest {
    """
    학교 또는 기관명입니다.
    """
    school: String

    """
    전공명입니다.
    """
    major: String

    """
    학위입니다. (학사/석사/박사)
    """
    degree: Degree

    """
    학적 상태입니다. (재학/휴학/졸업/졸업예정/수료)
    """
    status: EducationStatus

    """
    기간입니다.
    """
    period: PeriodInput
}

"""
경력 입력입니다.
"""
input ProfileCareerRequest {
    """
    회사명입니다.
    """
    company: String

    """
    직책입니다.
    """
    position: String

    """
    기간입니다.
    """
    period: PeriodInput

    """
    세부 내용입니다. (최대 500자)
    """
    description: String
}

"""
어학 입력입니다.
"""
input ProfileLanguageTestRequest {
    """
    시험명입니다.
    """
    testName: String

    """
    점수 또는 등급입니다.
    """
    score: String

    """
    취득일입니다. (YYYY-MM-DD)
    """
    acquiredAt: String
}

"""
수상 입력입니다.
"""
input ProfileAwardRequest {
    """
    수상명입니다.
    """
    title: String

    """
    수여 기관명입니다.
    """
    organization: String

    """
    수상일입니다. (YYYY-MM-DD)
    """
    awardedAt: String
}

"""
자격증 입력입니다.
"""
input ProfileCertificationRequest {
    """
    자격명입니다.
    """
    name: String

    """
    발급 기관명입니다.
    """
    issuer: String

    """
    취득일입니다. (YYYY-MM-DD)
    """
    acquiredAt: String
}

"""
스킬 입력입니다.
"""
input ProfileSkillRequest {
    """
    기술 또는 도구명입니다.
    """
    name: String

    """
    숙련도입니다. (상/중/하)
    """
    level: SkillLevel
}

"""
프로필 텍스트 AI 다듬기 입력입니다.
"""
input PolishProfileTextRequest {
    """
    다듬을 원문입니다. (최대 600자)
    """
    text: String!

    """
    다듬기 대상 항목입니다. 항목별 글자수 제한에 맞춰 다듬습니다.
    """
    kind: ProfilePolishKind!
}
