    """
    회사명입니다.
    """
    companyName: String!

    """
    직무 또는 역할입니다.
    """
    role: String

    """
    재직 기간입니다.
    """
    period: Period

    """
    경력 상세 내용입니다.
    """
    contents: String!
}

