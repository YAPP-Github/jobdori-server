    """
    학교명입니다.
    """
    schoolName: String!

    """
    전공명입니다.
    """
    major: String

    """
    학위 또는 학력 구분입니다.
    """
    degree: String

    """
    학력 상태입니다. 예: 졸업 예정
    """
    status: String

    """
    재학 기간입니다.
    """
    period: Period
}

