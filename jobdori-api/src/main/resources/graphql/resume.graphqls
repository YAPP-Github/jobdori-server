    """
    기술명입니다.
    """
    name: String!

    """
    숙련도 또는 수준입니다.
    """
    level: String
}

"""
어학 payload 응답입니다.
"""
type ResumeLanguagePayload {
    """
    어학 시험명입니다.
    """
    examName: String!

    """
    어학 점수 또는 등급입니다.
    """
    scoreOrGrade: String!

    """
    어학 취득일입니다.
    """
    acquiredAt: String
}

"""
이력서 템플릿 종류입니다.
"""
enum ResumeTemplate {
    """
    기본 이력서 템플릿입니다.
    """
    DEFAULT
}

"""
이력서 상태입니다.
"""
enum ResumeStatusType {
    """
    활성 이력서입니다.
    """
    COMPLETED

    """
    임시 저장된 이력서입니다.
    """
    DRAFT
}

"""
이력서 섹션 종류입니다.
"""
enum ResumeSectionType {
    """
    기본 정보 섹션입니다.
    """
    BASIC_INFO

    """
    핵심 역량 섹션입니다.
    """
    CORE_SKILL

    """
    경험 섹션입니다.
    """
    EXPERIENCE

    """
    경력 섹션입니다.
    """
    CAREER

    """
    학력 섹션입니다.
    """
    EDUCATION

    """
    어학 섹션입니다.
    """
    LANGUAGE

    """
    수상 섹션입니다.
    """
    AWARD

    """
    자격증 섹션입니다.
    """
    CERTIFICATE

    """
    기술 섹션입니다.
    """
    SKILL
}
